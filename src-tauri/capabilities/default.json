{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: core events/commands, native dialogs, notifications, reveal in Finder. Nothing else (no shell, fs, http).",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:webview:allow-internal-toggle-devtools",
    "dialog:default",
    "notification:default",
    "opener:allow-reveal-item-in-dir"
  ]
}
